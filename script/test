#!/bin/bash

# script/test: Run project tests
#
# Runs pytest with project configuration. Automatically cleans up package
# installations after test run to prevent Home Assistant from loading the
# wrong version.
#
# Usage:
#   ./script/test [OPTIONS] [PYTEST_OPTIONS]
#
# Options:
#   --cov           Generate coverage report (terminal output)
#   --cov-html      Generate HTML coverage report in htmlcov/
#
# Examples:
#   ./script/test
#   ./script/test -v
#   ./script/test --cov
#   ./script/test --cov-html
#   ./script/test --cov -k test_coordinator
#   ./script/test tests/test_api_wrapper.py

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

TEST_PYTHON_VERSION="3.14.2"
# Fallback versions used when PyPI is unreachable. pytest-homeassistant is
# released with every Home Assistant version and pins that exact release.
TEST_HOME_ASSISTANT_VERSION="2026.11.0b6"
TEST_PLUGIN_VERSION="2026.11.0b6"

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"

if ! command -v uv >/dev/null 2>&1; then
    log_error "uv is required to provision the isolated test environment"
    log_info "Run: ./script/setup/bootstrap"
    exit 1
fi

if [[ -n "${REMOTE_CONTAINERS:-}" || -n "${CODESPACES:-}" ]]; then
    TEST_VENV_PATH="$HOME/.local/ha-test-venv"
else
    TEST_VENV_PATH="$PWD/.local/ha-test-venv"
fi

log_header "Detecting latest compatible test versions"
# Prefer the newest final pytest-homeassistant release; use the newest
# pre-release only while no final release exists.
DETECTED_VERSIONS=$(python3 - <<'PYEOF' 2>/dev/null
import json, re, sys, urllib.request

def key(version):
    match = re.fullmatch(r"(\d+)\.(\d+)\.(\d+)(?:(a|b|rc)(\d+))?", version)
    if not match:
        return None
    major, minor, patch, tag, num = match.groups()
    rank = {"a": 0, "b": 1, "rc": 2, None: 3}[tag]
    return (int(major), int(minor), int(patch), rank, int(num or 0))

try:
    url = "https://pypi.org/pypi/pytest-homeassistant/json"
    data = json.loads(urllib.request.urlopen(url, timeout=10).read())
    candidates = [
        version
        for version, files in data["releases"].items()
        if key(version) and key(version) >= (2026, 11, 0, 0, 0)
        and any(not item.get("yanked") for item in files)
    ]
    finals = [version for version in candidates if key(version)[3] == 3]
    for version in sorted(finals or candidates, key=key, reverse=True)[:5]:
        meta = json.loads(urllib.request.urlopen(
            f"https://pypi.org/pypi/pytest-homeassistant/{version}/json", timeout=5
        ).read())
        for req in meta["info"].get("requires_dist") or []:
            pin = re.fullmatch(r"homeassistant==(\S+)", req.strip())
            if pin:
                print(f"{version}:{pin.group(1)}")
                sys.exit(0)
except Exception:
    pass
sys.exit(1)
PYEOF
) && {
    TEST_PLUGIN_VERSION="${DETECTED_VERSIONS%%:*}"
    TEST_HOME_ASSISTANT_VERSION="${DETECTED_VERSIONS##*:}"
    log_info "Latest test pair: pytest-homeassistant==${TEST_PLUGIN_VERSION}, HA==${TEST_HOME_ASSISTANT_VERSION}"
} || log_warning "PyPI unreachable, using fallbacks: HA ${TEST_HOME_ASSISTANT_VERSION}, plugin ${TEST_PLUGIN_VERSION}"

log_header "Preparing isolated test environment"
uv python install "$TEST_PYTHON_VERSION"

CURRENT_TEST_PYTHON=""
CURRENT_TEST_HA=""
if [[ -x "$TEST_VENV_PATH/bin/python3" ]]; then
    CURRENT_TEST_PYTHON=$("$TEST_VENV_PATH/bin/python3" -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')" 2>/dev/null || true)
    CURRENT_TEST_HA=$("$TEST_VENV_PATH/bin/python3" -c "import homeassistant; print(homeassistant.__version__)" 2>/dev/null || true)
fi

if [[ ! -d "$TEST_VENV_PATH" ]]; then
    log_info "Creating test virtual environment at $TEST_VENV_PATH"
    uv venv --seed --python "$TEST_PYTHON_VERSION" "$TEST_VENV_PATH"
elif [[ ! -x "$TEST_VENV_PATH/bin/python3" || "$CURRENT_TEST_PYTHON" != "3.14" ]]; then
    log_warning "Existing test venv uses Python ${CURRENT_TEST_PYTHON:-unknown} - recreating for Python 3.14"
    rm -rf "$TEST_VENV_PATH"
    log_info "Creating test virtual environment at $TEST_VENV_PATH"
    uv venv --seed --python "$TEST_PYTHON_VERSION" "$TEST_VENV_PATH"
elif [[ "$CURRENT_TEST_HA" != "$TEST_HOME_ASSISTANT_VERSION" ]]; then
    log_info "HA version changed (${CURRENT_TEST_HA:-none} → ${TEST_HOME_ASSISTANT_VERSION}) - rebuilding test venv"
    rm -rf "$TEST_VENV_PATH"
    uv venv --seed --python "$TEST_PYTHON_VERSION" "$TEST_VENV_PATH"
fi

# Tests run in a dedicated environment pinned to the Home Assistant release
# that pytest-homeassistant requires.
# shellcheck source=/dev/null
source "$TEST_VENV_PATH/bin/activate"

log_info "Installing compatible Home Assistant test dependencies"
# The old plugin supplies overlapping fixtures; never install both.
uv pip uninstall pytest-homeassistant-custom-component >/dev/null 2>&1 || true
uv pip install \
    -e . \
    "homeassistant==${TEST_HOME_ASSISTANT_VERSION}" \
    "pytest-homeassistant==${TEST_PLUGIN_VERSION}" \
    "pytest>=8.0.0" \
    "pytest-asyncio>=0.23.0" \
    "pytest-cov>=4.0.0" \
    "pytest-timeout>=2.0.0"

# Parse coverage flags
COVERAGE_ARGS=()
PYTEST_ARGS=()

while [[ $# -gt 0 ]]; do
    case $1 in
        --cov)
            COVERAGE_ARGS+=("--cov=custom_components/unraid_management_agent" "--cov-report=term-missing")
            shift
            ;;
        --cov-html)
            COVERAGE_ARGS+=("--cov=custom_components/unraid_management_agent" "--cov-report=html")
            shift
            ;;
        *)
            PYTEST_ARGS+=("$1")
            shift
            ;;
    esac
done

# Ensure cleanup runs even when tests fail (set -e would exit before cleanup)
cleanup() {
    "$SCRIPT_DIR/clean" --minimal || true
}
trap cleanup EXIT

# Run pytest with project configuration
if [[ ${#COVERAGE_ARGS[@]} -gt 0 ]]; then
    log_header "Running tests with coverage"
else
    log_header "Running tests"
fi
CMD=(pytest)
if [[ ${#COVERAGE_ARGS[@]} -gt 0 ]]; then
    CMD+=("${COVERAGE_ARGS[@]}")
fi
if [[ ${#PYTEST_ARGS[@]} -gt 0 ]]; then
    CMD+=("${PYTEST_ARGS[@]}")
fi
"${CMD[@]}"

if [[ ${#COVERAGE_ARGS[@]} -gt 0 ]] && [[ " ${COVERAGE_ARGS[*]} " =~ " --cov-report=html " ]]; then
    echo ""
    log_success "Coverage report generated in htmlcov/index.html"
fi
